# Blizu API settings (copy values into the repository-root .env or export them).
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/blizu
CONTACT_EMAIL=marko.subasic@susfer.hr
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Hugging Face cache for the optional semantic model (/search)
HF_HOME=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where raw/derived data lives (relative to the working directory or absolute)
DATA_DIR=apps/blizu/data
# OSM features: auto = try Overpass (3 attempts), then the Geofabrik Croatia extract; overpass | geofabrik force one
OSM_FEATURE_SOURCE=auto
