{"help": "https://data.gov.hr/ckan/api/3/action/help_show?name=package_show", "success": true, "result": {"access_rights": "", "applicable_legislation": "", "creator_user_id": "6f21602a-6b67-4e90-81cc-cfa5c9e8a0f7", "id": "29b704f9-493c-43d4-b1d9-bb91bdec76b1", "isopen": false, "license_title": null, "maintainer": null, "maintainer_email": null, "metadata_created": "2026-03-13T20:39:03.360997", "metadata_modified": "2026-03-13T20:39:03.361001", "name": "djeji-vrtii-osnovne-i-srednje-kole-grada-zagreba-inspire", "notes": "Dje\u010dji vrti\u0107i, osnovne i srednje \u0161kole Grada Zagreba", "num_resources": 4, "num_tags": 7, "organization": {"id": "427c6688-f7f9-4619-9dad-7e80e2f36dec", "name": "drzavna-geodetska-uprava", "title": "Dr\u017eavna geodetska uprava", "type": "organization", "description": "Dr\u017eavna geodetska uprava je dr\u017eavna upravna organizacija koja obavlja upravne i druge poslove koji se odnose na: geodetske i katastarske poslove, a posebice na izradu, obnovu i odr\u017eavanje katastra nekretnina, informatizaciju katastra i geodetsko-prostornog sustava, topografsku izmjeru i izradu dr\u017eavnih karata, vo\u0111enje geodetske dokumentacije, vo\u0111enje statisti\u010dkih podataka katastra nekretnina i infrastrukture, geodetsko-katastarske poslove za dr\u017eavnu granicu na kopnu, razvitak i primjenu tehnologije geodetske izmjere u znanosti, gospodarstvu i drugim djelatnostima u kojima se primjenjuju ili ostvaruju intervencije u prostoru. Poseban dio poslova iz nadle\u017enosti Dr\u017eavne geodetske uprave \u010dini briga o upravnim, stru\u010dnim, razvojnim i koordinacijskim poslovima Nacionalne infrastrukture prostornih podataka (NIPP) te poslovi implementacije INSPIRE direktive. Dr\u017eavna geodetska uprava obavlja i druge poslove koji su joj stavljeni u nadle\u017enost posebnim zakonom.", "image_url": "", "created": "2021-05-04T12:57:19.559479", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "427