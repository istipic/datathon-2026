# Birokratko API settings (copy values into the repository-root .env or export them).
# The nabavaradar database lives on the same server as blizu/otporno (see root .env.example).
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/nabavaradar
CONTACT_EMAIL=marko.subasic@susfer.hr

# --- Sudski registar (https://sudreg-data.gov.hr/): register, CONFIRM THE E-MAIL, then copy the
# Client ID / Client Secret. Credentials legitimately end with ".." (part of the value).
# An unconfirmed account gets a token but HTTP 401 on data calls. Test and production portals have
# separate registrations: the test host is https://sudreg-data-test.gov.hr
SUDREG_CLIENT_ID=
SUDREG_CLIENT_SECRET=
SUDREG_BASE_URL=https://sudreg-data.gov.hr/api/javni
SUDREG_TOKEN_URL=https://sudreg-data.gov.hr/api/oauth/token

# --- TED Search API v3 (anonymous)
TED_SEARCH_URL=https://api.ted.europa.eu/v3/notices/search

# --- Windows of the TED ingest (task: competition 120 days, results 36 months)
COMPETITION_DAYS=120
RESULT_MONTHS=36

# --- E-mail digest (dev: Mailpit on 127.0.0.1:1025, UI http://127.0.0.1:8025)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
# Base URL used in links inside e-mails (confirmation, unsubscribe, tender details)
PUBLIC_BASE_URL=http://localhost:5173
# Signs unsubscribe tokens (HMAC). Required when ENV=prod; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SUBSCRIPTION_SECRET=

# Hugging Face cache for the multilingual-e5-small model (~470 MB, downloaded on first use)
HF_HOME=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where raw downloads live (relative to the working directory or absolute)
DATA_DIR=apps/nabavaradar/data
