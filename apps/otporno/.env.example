# Otporko API settings (copy values into the repository-root .env or export them).
# The otporno database lives on the same server as blizu/nabavaradar (see root .env.example).
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/otporno
CONTACT_EMAIL=marko.subasic@susfer.hr

# Geocoding of addresses (anywhere in Croatia), cached 30 days
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Open-Meteo Climate API (free tier, CC BY 4.0, cost-limited: see docs/adr/0007)
OPEN_METEO_CLIMATE_URL=https://climate-api.open-meteo.com/v1/climate

# Hrvatske vode WMS (flood hazard maps 2019, overlay only)
HV_WMS_URL=https://servisi.voda.hr/wms

# Raw downloads (Geofabrik extract, Eurostat grid, GISCO LAU); derived files
DATA_DIR=apps/otporno/data

# Browser origins allowed to call the API (explicit list, no wildcard)
CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
